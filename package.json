{
  "name": "ovok-docs",
  "version": "0.1.0",
  "private": true,
  "description": "Documentation site for the Ovok platform.",
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "pnpm run gen:api && docusaurus start",
    "build": "pnpm run gen:api && docusaurus build",
    "gen:api": "node scripts/fetch-fhir-r5.mjs && node scripts/generate-api-docs.mjs",
    "gen:fhir-fetch": "node scripts/fetch-fhir-r5.mjs --force",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "typecheck": "tsc --noEmit",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids"
  },
  "dependencies": {
    "@docusaurus/core": "^3.7.0",
    "@docusaurus/preset-classic": "^3.7.0",
    "@docusaurus/theme-mermaid": "^3.7.0",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.7.0",
    "@docusaurus/tsconfig": "^3.7.0",
    "@docusaurus/types": "^3.7.0",
    "@types/js-yaml": "^4.0.9",
    "js-yaml": "^4.1.1",
    "typescript": "~5.5.2"
  },
  "pnpm": {
    "overrides": {
      "webpack": "5.97.1",
      "webpackbar": "6.0.1"
    }
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=18.0"
  }
}
